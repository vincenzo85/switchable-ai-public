# Copia in .env (git-ignorato). TUTTE le chiavi cloud sono OPZIONALI:
# senza, la rotta cloud fallisce subito e il fallback locale si esercita davvero.

# --- modelli -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
SAI_LOCAL_MODEL=ollama/qwen2.5:7b
SAI_RAG_MODEL=ollama/qwen2.5:7b
SAI_CLOUD_MODEL=cloud/gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
VLLM_BASE_URL=                 # es. http://localhost:8010 se lanci vLLM (benchmarks/run_vllm.py)

# --- gateway LiteLLM (opzionale: se vuoto si parla direttamente ai motori)
SAI_GATEWAY_URL=               # es. http://localhost:4000
SAI_GATEWAY_KEY=sk-switchable-demo

# --- policy ---------------------------------------------------------------
SAI_LOCAL_ONLY=false
SAI_BUDGET_EUR=0               # 0 = nessun budget; es. 2.00 al giorno
SAI_BUDGET_GUARD_EUR=0         # sotto questo residuo: local-first
SAI_CLOUD_TIMEOUT_S=60
SAI_COMPRESS=extractive        # extractive | none (solo sulla rotta a pagamento)
SAI_COMPRESS_THRESHOLD=1500    # token stimati oltre i quali si comprime

# --- router appreso (Rizzo Flow / Open-Jev) — opzionale ----------------------
SAI_ADVISOR=                   # rizzo | openjev | vuoto = spento
SAI_ADVISOR_MODE=shadow        # shadow (misura) | active (decide sempre) | fallback (solo quando la regola tira a indovinare)
SAI_ADVISOR_BOTH_ORDERS=false  # doppio ordine dei candidati: misurato, nessun guadagno, latenza doppia
SAI_ADVISOR_MIN_P=0.6

# --- osservabilità ----------------------------------------------------------
LANGFUSE_HOST=                 # es. http://localhost:3011
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
